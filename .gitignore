# =========================
# Java Project .gitignore
# VS Code + No Build Tool
# =========================

# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*

# =========================
# VS Code
# =========================

.vscode/

# Optional: Keep workspace settings
# !.vscode/settings.json
# !.vscode/extensions.json
# !.vscode/launch.json
# !.vscode/tasks.json

# =========================
# OS Generated Files
# =========================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~

# =========================
# Java Runtime / Temp Files
# =========================

*.tmp
*.swp
*.bak

# =========================
# Output Directories
# =========================

bin/
out/
target/
build/

# =========================
# IntelliJ IDEA (Optional)
# =========================

.idea/
*.iml

# =========================
# Eclipse (Optional)
# =========================

.project
.classpath
.settings/

# =========================
# NetBeans (Optional)
# =========================

nbproject/private/
build/
dist/

# =========================
# Maven (If added later)
# =========================

.mvn/